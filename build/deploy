#!/bin/bash

# source: https://github.com/alshedivat/al-folio/blob/master/bin/deploy

SRC_BRANCH="${1:-master}"
DEPLOY_BRANCH="gh-pages"

# Exit if any subcommand fails
set -e

echo "Deploying..."
echo "Source branch: $SRC_BRANCH"
echo "Deploy branch: $DEPLOY_BRANCH"

# Safety check: Warn about uncommitted changes
if ! git diff-index --quiet HEAD --; then
    echo "⚠️  WARNING: You have uncommitted changes!"
    echo "The following files have uncommitted changes:"
    git diff-index --name-only HEAD --
    echo ""
    echo "🚨 DANGER: The deploy script will DELETE all untracked files and directories!"
    echo "This includes any work-in-progress folders like '_new', '_drafts', etc."
    echo ""
    echo "To proceed safely:"
    echo "1. Commit your changes: git add . && git commit -m 'your message'"
    echo "2. Or stash them: git stash"
    echo ""
    echo "Aborting deployment to prevent data loss."
    [[ "$0" = "$BASH_SOURCE" ]] && exit 1 || return 1
fi

# Additional safety check: Warn about untracked files/directories
if [ -n "$(git ls-files --others --exclude-standard)" ]; then
    echo "⚠️  WARNING: You have untracked files that will be DELETED by deployment!"
    echo "The following untracked files/directories will be permanently deleted:"
    git ls-files --others --exclude-standard
    echo ""
    echo "This includes folders like '_new', '_drafts', or any other untracked directories."
    echo "For safety, deployment is aborted. Please commit or remove these files first."
    echo "Aborting deployment to prevent data loss."
    [[ "$0" = "$BASH_SOURCE" ]] && exit 1 || return 1
fi

# Switch to source branch (creates it if necessary from the current branch)
if [ `git branch | grep $SRC_BRANCH | tr ' ' '\n' | tail -1` ]
then
    git checkout $SRC_BRANCH
else
    git checkout -b $SRC_BRANCH
fi

# Checkout DEPLOY_BRANCH branch
if [ `git branch | grep $DEPLOY_BRANCH` ]
then
  git branch -D $DEPLOY_BRANCH
fi
git checkout -b $DEPLOY_BRANCH

# Build site
bundle exec jekyll build

# Delete and move files
find . -maxdepth 1 ! -name '_site' ! -name '.git' ! -name 'CNAME' ! -name '.gitignore' -exec rm -rf {} \;
mv _site/* .
rm -R _site/

# Push to DEPLOY_BRANCH
git add -fA
git commit --allow-empty -m "$(git log -1 --pretty=%B) [ci skip]"
git push -f -q origin $DEPLOY_BRANCH

# Move back to SRC_BRANCH
git checkout $SRC_BRANCH

echo "Deployed successfully!"

exit 0
